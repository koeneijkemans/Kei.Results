<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>10</LangVersion>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Kei.Results</PackageId>
    <Version>0.0.2</Version>
    <Authors>Koen Eijkemans</Authors>
    <Company>Koen Eijkemans</Company>
    <Description>Small result type helpers for success and failure flows.</Description>
    <PackageTags>result;error;success;failure</PackageTags>
    <RepositoryUrl>https://github.com/koeneijkemans/Kei.Results</RepositoryUrl>
    <PackageProjectUrl>https://github.com/koeneijkemans/Kei.Results</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
